# ===== 本地开发默认值（与 docker-compose.yml 对应）=====
# cp .env.example .env 后即可本地开发。
# 生产部署务必替换全部值：密钥用 `openssl rand -hex 32` 生成，
# 数据库/对象存储改为你自己的地址与凭据！

NODE_ENV=development

# API 监听端口
PORT=3000

# MySQL：docker compose 里的 family_frame 库（root 密码见 docker-compose.yml）
DATABASE_URL=mysql://root:family_frame_root@127.0.0.1:3306/family_frame

# MinIO（docker compose 的 S3 兼容存储；生产用私有桶 + 正式凭据）
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=family-frame
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_INTERNAL_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000

# Web 构建产物目录（生产镜像内路径；本地开发由 Vite 自行服务，可留空）
WEB_DIST_DIR=apps/web/dist

# 会话密钥与设备令牌盐：生产环境必须用 `openssl rand -hex 32` 重新生成！
# （下面的 dev-only 示例值仅用于本地开发）
SESSION_SECRET=dev-only-session-secret-change-me-0123456789abcdef
DEVICE_TOKEN_PEPPER=dev-only-token-pepper-change-me-0123456789abcdef

# 家人端公开地址（生产为你的对外域名）
PUBLIC_APP_URL=http://127.0.0.1:3000
